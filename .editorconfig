# Editor settings for every file in the project (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,js,css}]
# Prettier's standard for web files.
indent_size = 2

[*.md]
# Two spaces at the end of a line are a line break in Markdown.
trim_trailing_whitespace = false

[{*.yml,*.yaml}]
indent_size = 2
